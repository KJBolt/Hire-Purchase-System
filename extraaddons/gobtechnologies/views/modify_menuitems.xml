<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hide Discuss Menu Item -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active">False</field>
    </record>


    <!-- Hide Dashboard Menu Item -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>


    <!-- Hide Link Tracker Menu Item -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>
    

    <!-- Show Contacts Menu Item -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="active">True</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_repayment_sales'),
                ref('gobtechnologies.group_repayment_agent'),
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager'),

            ])]"
        />
    </record>


    <!-- Show Sales Menu Item -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="active">True</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_repayment_sales'),
                ref('gobtechnologies.group_repayment_agent'),
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager'),

            ])]"
        />
    </record>


    <!-- Show Invoicing Menu Item -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="active">True</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_repayment_sales'),
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager'),

            ])]"
        />
    </record>


    <!-- Show Inventory Menu Item -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="active">True</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager'),

            ])]"
        />
    </record>


    <!-- Show Purchase Menu Item -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="active">True</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager'),
            ])]"
        />
    </record>




    <!-- Hide Apps for all users except Administrators (System) -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>


    <!-- Nuovo Pay Menu Item -->
    <!-- Client Actions -->
    <record id="action_nuovo_pay" model="ir.actions.client">
        <field name="name">NuovoPay</field>
        <field name="tag">gobtechnologies.nuovo_pay</field>
    </record>
    
    <record id="action_oppo_lock" model="ir.actions.client">
        <field name="name">Oppo Lock</field>
        <field name="tag">gobtechnologies.oppo_lock</field>
    </record>

    

    <record id="action_nuovo_pay_lock_form" model="ir.actions.act_window">
        <field name="name">Register Device</field>
        <field name="res_model">nuovopay.lock</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_oppo_lock_form" model="ir.actions.act_window">
        <field name="name">Add Oppo Device</field>
        <field name="res_model">oppo.lock</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_users" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('gobtechnologies.view_users_tree_inherit')}), (0, 0, {'view_mode': 'form', 'view_id': ref('gobtechnologies.view_users_form_inherit')})]"/>
        <field name="target">current</field>
    </record>

    <!-- <menuitem 
        id="menu_nuovo_pay" 
        name="Lock Device"
        parent="menu_repayment_root"
        action="action_nuovo_pay"
    /> -->

    <menuitem 
        id="menu_oppo_lock" 
        name="Oppo Lock"
        parent="menu_repayment_root"
        action="action_oppo_lock"
        groups="gobtechnologies.group_supervisor"
    />

    <menuitem 
        id="menu_imei_capture" 
        name="IMEI Capture"
        action="gobtechnologies.action_sales_agent_imei_capture"
        sequence="13"
    />



    <!-- Dashboard Actions -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">gobtechnologies.dashboard</field>
    </record>

    <record id="action_user_management" model="ir.actions.client">
        <field name="name">User Management</field>
        <field name="tag">gobtechnologies.user_management</field>
    </record>

    <record id="action_customer_management" model="ir.actions.client">
        <field name="name">Customer Management</field>
        <field name="tag">gobtechnologies.customer_management</field>
    </record>
    
    <!-- <record id="action_stock_management" model="ir.actions.client">
        <field name="name">Stock Management</field>
        <field name="tag">gobtechnologies.stock_management</field>
    </record>
    
    <record id="action_auditing" model="ir.actions.client">
        <field name="name">Auditing</field>
        <field name="tag">gobtechnologies.auditing</field>
    </record>

    <record id="action_reports" model="ir.actions.client">
        <field name="name">Reports</field>
        <field name="tag">gobtechnologies.reports</field>
    </record> -->
    

    <!-- Dashboard Menu Items -->
    <record id="menu_dashboard" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="action" ref="action_dashboard"/>
        <field name="sequence">10</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_repayment_sales'),
                ref('gobtechnologies.group_repayment_agent'),
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_general_manager')
            ])]"
        />
    </record>

    <!-- Show Users Menu Item -->
    <record id="menu_users" model="ir.ui.menu">
        <field name="name">Users</field>
        <field name="action" ref="action_users"/>
        <field name="sequence">11</field>
        <field 
            name="groups_id" 
            eval="[(6, 0, [
                ref('gobtechnologies.group_internal_auditor'),
                ref('gobtechnologies.group_supervisor'),
                ref('gobtechnologies.group_sales_administrator'),
                ref('gobtechnologies.group_general_manager'),
            ])]"
        />
    </record>

    <menuitem 
        id="menu_user_management" 
        name="User Management"
        parent="menu_dashboard"
        action="action_user_management"
    />

    <menuitem 
        id="menu_customer_management" 
        name="Customer Management"
        parent="menu_dashboard"
        action="action_customer_management"
    />

