<templates xml:space="preserve">
    <t t-name="gobtechnologies.nuovo_pay" owl="1">
        <div class="o_nuovopay_dashboard p-5 bg-light min-vh-100">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border-start border-primary border-4">
                <div>
                    <h2 class="mb-0 fw-bold text-primary">Device Management</h2>
                    <p class="text-muted mb-0">Monitor and control device lock statuses</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" t-on-click="() => this.fetchDevices()">
                        <i class="fa fa-refresh me-1"></i> Refresh Data
                    </button>
                    <button class="btn btn-primary" t-on-click="() => this.action.doAction('gobtechnologies.action_nuovo_pay_lock_form')">
                        <i class="fa fa-plus me-1"></i> Register Device
                    </button>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                <i class="fa fa-mobile fa-2x px-2 text-secondary"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Total Devices</h6>
                                <h3 class="mb-0 fw-bold" t-esc="state.devices.length"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100 border-bottom border-danger border-3">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                                <i class="fa fa-lock fa-2x px-1 text-secondary"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Locked</h6>
                                <h3 class="mb-0 fw-bold text-danger" t-esc="state.lockedCount"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100 border-bottom border-success border-3">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                <i class="fa fa-unlock fa-2x text-secondary"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Unlocked</h6>
                                <h3 class="mb-0 fw-bold text-success" t-esc="state.unlockedCount"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                                <i class="fa fa-history fa-2x text-secondary"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Recent Activity</h6>
                                <h3 class="mb-0 fw-bold">Active</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Device Table -->
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white py-3">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="mb-0 fw-bold">Connected Devices</h5>
                        </div>
                        <div class="col-auto">
                            <div class="input-group input-group-sm" style="width: 250px;">
                                <span class="input-group-text bg-light border-0"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-0" placeholder="Search devices..." t-on-input="onSearchInput"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Device Details</th>
                                <th>Repayment Ref</th>
                                <th>Device ID</th>
                                <th>Status</th>
                                <th>Last Action</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.filteredDevices" t-as="device" t-key="device.id">
                                <!-- Confirm Unregister Row -->
                                <tr t-if="state.confirmUnregisterId === device.id" class="table-warning">
                                    <td colspan="6" class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="fa fa-exclamation-triangle text-warning fa-lg"></i>
                                            <span class="fw-semibold">Are you sure you want to unregister <strong t-esc="device.name"/>"? This will remove the device from NuovoPay and cannot be undone.</span>
                                            <button class="btn btn-danger btn-sm ms-2" t-on-click="() => this.unregisterDevice(device)">
                                                <i class="fa fa-trash me-1"></i> Yes, Unregister
                                            </button>
                                            <button class="btn btn-secondary btn-sm" t-on-click="() => this.cancelUnregister()">
                                                Cancel
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Device Row -->
                                <tr t-else="">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-light rounded p-2 me-3">
                                                <i class="fa fa-mobile fa-lg text-secondary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold" t-esc="device.name"/>
                                                <div class="small text-muted">ID: <t t-esc="device.id"/></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border" t-esc="device.repayment_id[1]"/>
                                    </td>
                                    <td>
                                        <code t-esc="device.device_id"/>
                                    </td>
                                    <td>
                                        <span t-attf-class="badge rounded-pill px-3 py-2 #{device.status === 'locked' ? 'bg-danger-light text-danger' : 'bg-success-light text-success'}">
                                            <i t-attf-class="fa #{device.status === 'locked' ? 'fa-lock' : 'fa-unlock-alt'} me-1"></i>
                                            <t t-esc="device.status"/>
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <div t-if="device.lock_date"><i class="fa fa-clock-o me-1"></i> Locked: <t t-esc="device.lock_date"/></div>
                                        <div t-if="device.unlock_date"><i class="fa fa-clock-o me-1"></i> Unlocked: <t t-esc="device.unlock_date"/></div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm">
                                            <button t-if="device.status === 'unlocked'" class="btn btn-danger" t-on-click="() => this.toggleLock(device, 'lock')" title="Lock Device">
                                                Lock
                                            </button>
                                            <button t-if="device.status === 'locked'" class="btn btn-success" t-on-click="() => this.toggleLock(device, 'unlock')" title="Unlock Device">
                                                Unlock
                                            </button>
                                            <button class="btn btn-white border" t-on-click="() => this.openDevice(device.id)" title="View Details">
                                                View
                                            </button>
                                            <button class="btn btn-warning border" t-on-click="() => this.confirmUnregister(device.id)" title="Unregister Device">
                                                Unregister
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="state.filteredDevices.length === 0">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa fa-search fa-3x mb-3 opacity-25"></i>
                                    <p>No devices found matching your search.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <style>
            .o_nuovopay_dashboard .bg-danger-light { background-color: #f8d7da; }
            .o_nuovopay_dashboard .bg-success-light { background-color: #d1e7dd; }
            .o_nuovopay_dashboard .btn-white { background: white; }
            .o_nuovopay_dashboard .avatar { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
            .o_nuovopay_dashboard .table thead th { border-top: none; }
        </style>
    </t>
</templates>