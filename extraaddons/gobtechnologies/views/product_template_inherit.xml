<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_extension" model="ir.ui.view">
            <field name="name">product.tempate.form.extension</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="before">
                    <group string="Sales Commission" class="mb-3">
                        <group>
                            <field name="sales_commission_type"/>
                        </group>
                        <group>
                            <field name="sales_commission_value"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
