<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_lot_tree_inherit" model="ir.ui.view">
            <field name="name">stock.lot.tree.inherit</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <!-- Hide create button from tree view -->
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>

                <!-- Add delivery status and warehouse fields after name field -->
                <xpath expr="//field[@name='name']" position="after">
                    <field name="delivery_status" readonly="1" widget="badge" decoration-success="delivery_status == 'delivered'" decoration-warning="delivery_status == 'not_delivered'"/>
                    <field name="is_expired" readonly="1" widget="badge" decoration-danger="is_expired == 'expired'" decoration-success="is_expired == 'not_expired'"/>
                    <field name="expiration_date" readonly="1"/>
                    <field name="warehouse_id" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>