<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hide Discuss Menu Item -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- Hide Dashboard Menu Item -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- Hide Link Tracker Menu Item -->
    <!-- <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record> -->
    
    <!-- Show Contacts Menu Item -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="active">True</field>
    </record>

    <!-- Hide Apps for all users except Administrators (System) -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Nuovo Pay Menu Item -->
    <!-- Client Actions -->
    <record id="action_nuovo_pay" model="ir.actions.client">
        <field name="name">NuovoPay</field>
        <field name="tag">gobtechnologies.nuovo_pay</field>
    </record>

    <record id="action_nuovo_pay_lock_form" model="ir.actions.act_window">
        <field name="name">Register Device</field>
        <field name="res_model">nuovopay.lock</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem 
        id="menu_nuovo_pay" 
        name="Lock Device"
        parent="menu_repayment_root"
        action="action_nuovo_pay"
    />



    <!-- Dashboard Menus -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">gobtechnologies.dashboard</field>
    </record>

    <record id="action_user_management" model="ir.actions.client">
        <field name="name">User Management</field>
        <field name="tag">gobtechnologies.user_management</field>
    </record>

    <record id="action_customer_management" model="ir.actions.client">
        <field name="name">Customer Management</field>
        <field name="tag">gobtechnologies.customer_management</field>
    </record>
    
    <record id="action_stock_management" model="ir.actions.client">
        <field name="name">Stock Management</field>
        <field name="tag">gobtechnologies.stock_management</field>
    </record>
    
    <record id="action_auditing" model="ir.actions.client">
        <field name="name">Auditing</field>
        <field name="tag">gobtechnologies.auditing</field>
    </record>
    

    
    <menuitem 
        id="menu_dashboard" 
        name="Dashboard"
        action="action_dashboard"
        sequence="10"
    />

    <menuitem 
        id="menu_user_management" 
        name="User Management"
        parent="menu_dashboard"
        action="action_user_management"
    />

    <menuitem 
        id="menu_customer_management" 
        name="Customer Management"
        parent="menu_dashboard"
        action="action_customer_management"
    />

    <menuitem 
        id="menu_stock_management" 
        name="Stock Management"
        parent="menu_dashboard"
        action="action_stock_management"
    />

    <menuitem 
        id="menu_reports" 
        name="Reports"
        parent="menu_dashboard"
        action="action_nuovo_pay"
    />

    <menuitem 
        id="menu_auditing" 
        name="Auditing"
        parent="menu_dashboard"
        action="action_auditing"
    />

</odoo>