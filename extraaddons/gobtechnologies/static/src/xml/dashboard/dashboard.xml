<templates xml:space="preserve">
    <t t-name="gobtechnologies.dashboard">
        <div class="o_dashboard_container" style="background-color: #f8f9fa; padding: 20px; height: 100vh; overflow-y:auto;">
            
            <!-- Welcome Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 style="font-size: 24px; font-weight: 600; color: #1a1a2e; margin: 0;">Welcome back, <t t-esc="env.services.user.name || 'User'"/></h2>
                    <p style="color: #6c757d; margin: 5px 0 0 0; font-size: 14px;">Here's what's happening with your business today</p>
                </div>
                <button class="btn btn-primary" style="background-color: #6366f1; border: none; border-radius: 8px; padding: 10px 20px;">
                    <i class="fa fa-download me-2"/>Export Report
                </button>
            </div>

            <!-- KPI Cards Row 1 -->
            <div class="row mb-2">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">OVERALL REPAYMENT %</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">68.3%</h3>
                                    <p style="color: #10b981; font-size: 12px; margin-top: 8px;">
                                        <i class="fa fa-arrow-up"/> +2.4% from last month
                                    </p>
                                </div>
                                <div style="background-color: #e0e7ff; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-percent" style="color: #6366f1; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4 mb-2">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">SALES MANAGERS</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">2</h3>
                                    <p style="color: #10b981; font-size: 12px; margin-top: 8px;">
                                        Active managers
                                    </p>
                                </div>
                                <div style="background-color: #d1fae5; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-user" style="color: #10b981; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4 mb-2">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">SALES AGENTS</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">3</h3>
                                    <p style="color: #10b981; font-size: 12px; margin-top: 8px;">
                                        <i class="fa fa-arrow-up"/> +1 this month
                                    </p>
                                </div>
                                <div style="background-color: #d1fae5; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-users" style="color: #10b981; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Cards Row 2 -->
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">TOTAL STOCK VALUE</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">₵400K</h3>
                                    <p style="color: #10b981; font-size: 12px; margin-top: 8px;">
                                        Across all branches
                                    </p>
                                </div>
                                <div style="background-color: #dbeafe; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-user-plus" style="color: #3b82f6; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">MONTHLY SALES</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">₵52K</h3>
                                    <!-- <p style="color: #f59e0b; font-size: 12px; margin-top: 8px;">
                                        <i class="fa fa-clock"/> Requires attention
                                    </p> -->
                                </div>
                                <div style="background-color: #fef3c7; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-tasks" style="color: #f59e0b; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm" style="border: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p style="color: #6c757d; font-size: 12px; margin-bottom: 8px;">OVERDUE ACCOUNTS</p>
                                    <h3 style="font-size: 28px; font-weight: 700; color: #1a1a2e; margin: 0;">1</h3>
                                    <p style="color: #10b981; font-size: 12px; margin-top: 8px;">
                                        <i class="fa fa-check"/> On track
                                    </p>
                                </div>
                                <div style="background-color: #e0e7ff; padding: 12px; border-radius: 10px;">
                                    <i class="fa fa-folder-open" style="color: #6366f1; font-size: 20px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="row mb-4">
                <!-- Bar Chart -->
                <div class="col-lg-8 mb-3">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Monthly Sales Performance</h5>
                                <select class="form-select form-select-sm" style="width: 120px; border-radius: 6px;">
                                    <option>Last 6 Months</option>
                                    <option>Last Year</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="height: 300px;">
                                <canvas t-ref="salesChartCanvas" style="width: 100%; height: 100%;"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Donut Chart -->
                <div class="col-lg-4 mb-3">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Payment Distribution</h5>
                        </div>
                        <div class="card-body text-center">
                            <div style="height: 250px; position: relative;">
                                <canvas t-ref="donutChartCanvas"/>
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                                    <h3 style="font-size: 24px; font-weight: 700; color: #1a1a2e; margin: 0;">68.3%</h3>
                                    <p style="color: #6c757d; font-size: 12px; margin: 0;">Paid</p>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center mt-3" style="gap: 20px;">
                                <div class="d-flex align-items-center">
                                    <span style="width: 12px; height: 12px; background-color: #3b82f6; border-radius: 50%; margin-right: 8px;"/>
                                    <span style="font-size: 12px; color: #6c757d;">Paid</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span style="width: 12px; height: 12px; background-color: #ef4444; border-radius: 50%; margin-right: 8px;"/>
                                    <span style="font-size: 12px; color: #6c757d;">Pending</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span style="width: 12px; height: 12px; background-color: #10b981; border-radius: 50%; margin-right: 8px;"/>
                                    <span style="font-size: 12px; color: #6c757d;">Overdue</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer Table & Horizontal Charts -->
            <div class="row mb-4">
                <div class="col-lg-8 mb-3">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Active Customer Installments</h5>
                                <button class="btn btn-sm btn-outline-primary">View All</button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead style="background-color: #f8f9fa;">
                                    <tr>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Customer</th>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Product</th>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Installments</th>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Total Price</th>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Paid</th>
                                        <th style="padding: 15px 20px; font-size: 12px; color: #6c757d; font-weight: 600; border: none;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 32px; height: 32px; background-color: #6366f1; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; margin-right: 12px;">JD</div>
                                                <span style="font-weight: 500;">John Doe</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">iPhone 15 Pro</td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">8/12</td>
                                        <td style="padding: 15px 20px; border: none; font-weight: 600;">€1,299</td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 80px; height: 6px; background-color: #e5e7eb; border-radius: 3px; margin-right: 10px; overflow: hidden;">
                                                    <div style="width: 67%; height: 100%; background-color: #3b82f6; border-radius: 3px;"/>
                                                </div>
                                                <span style="font-size: 12px; color: #6c757d;">67%</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <span style="background-color: #d1fae5; color: #10b981; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 32px; height: 32px; background-color: #ec4899; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; margin-right: 12px;">JS</div>
                                                <span style="font-weight: 500;">Jane Smith</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">MacBook Air</td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">10/12</td>
                                        <td style="padding: 15px 20px; border: none; font-weight: 600;">€1,499</td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 80px; height: 6px; background-color: #e5e7eb; border-radius: 3px; margin-right: 10px; overflow: hidden;">
                                                    <div style="width: 83%; height: 100%; background-color: #10b981; border-radius: 3px;"/>
                                                </div>
                                                <span style="font-size: 12px; color: #6c757d;">83%</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <span style="background-color: #d1fae5; color: #10b981; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 32px; height: 32px; background-color: #f59e0b; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; margin-right: 12px;">MR</div>
                                                <span style="font-weight: 500;">Mike Ross</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">iPad Pro</td>
                                        <td style="padding: 15px 20px; border: none; color: #6c757d;">3/12</td>
                                        <td style="padding: 15px 20px; border: none; font-weight: 600;">€899</td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 80px; height: 6px; background-color: #e5e7eb; border-radius: 3px; margin-right: 10px; overflow: hidden;">
                                                    <div style="width: 25%; height: 100%; background-color: #ef4444; border-radius: 3px;"/>
                                                </div>
                                                <span style="font-size: 12px; color: #6c757d;">25%</span>
                                            </div>
                                        </td>
                                        <td style="padding: 15px 20px; border: none;">
                                            <span style="background-color: #fee2e2; color: #ef4444; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;">At Risk</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <!-- Top Agents Chart -->
                <div class="col-lg-4 mb-3">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Top Agents by Repayment %</h5>
                        </div>
                        <div class="card-body">
                            <div style="height: 200px;">
                                <canvas t-ref="agentsChartCanvas"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stock Aging Report -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Stock Aging Report</h5>
                                <div class="d-flex" style="gap: 10px;">
                                    <span class="d-flex align-items-center">
                                        <span style="width: 12px; height: 12px; background-color: #3b82f6; border-radius: 2px; margin-right: 6px;"/>
                                        <span style="font-size: 12px; color: #6c757d;">0-30 days</span>
                                    </span>
                                    <span class="d-flex align-items-center">
                                        <span style="width: 12px; height: 12px; background-color: #10b981; border-radius: 2px; margin-right: 6px;"/>
                                        <span style="font-size: 12px; color: #6c757d;">31-60 days</span>
                                    </span>
                                    <span class="d-flex align-items-center">
                                        <span style="width: 12px; height: 12px; background-color: #f59e0b; border-radius: 2px; margin-right: 6px;"/>
                                        <span style="font-size: 12px; color: #6c757d;">61-90 days</span>
                                    </span>
                                    <span class="d-flex align-items-center">
                                        <span style="width: 12px; height: 12px; background-color: #ef4444; border-radius: 2px; margin-right: 6px;"/>
                                        <span style="font-size: 12px; color: #6c757d;">90+ days</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="height: 250px;">
                                <canvas t-ref="stockChartCanvas"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Activity Log -->
            <div class="row" style="margin-bottom: 80px;">
                <div class="col-12">
                    <div class="card" style="border: none; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <div class="card-header bg-white" style="border-bottom: 1px solid #e5e7eb; padding: 20px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 style="margin: 0; font-weight: 600; color: #1a1a2e;">Activity Log</h5>
                                <div class="d-flex" style="gap: 10px;">
                                    <button class="btn btn-sm btn-outline-secondary">Today</button>
                                    <button class="btn btn-sm btn-outline-secondary">Week</button>
                                    <button class="btn btn-sm btn-outline-secondary">Month</button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-column" style="gap: 15px;">
                                <div class="d-flex align-items-start">
                                    <div style="width: 32px; height: 32px; background-color: #d1fae5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px; flex-shrink: 0;">
                                        <i class="fa fa-check" style="color: #10b981; font-size: 12px;"/>
                                    </div>
                                    <div style="flex: 1;">
                                        <p style="margin: 0; font-weight: 500; color: #1a1a2e;">Payment received from John Doe</p>
                                        <p style="margin: 4px 0 0 0; font-size: 12px; color: #6c757d;">€108.25 • 2 hours ago</p>
                                    </div>
                                    <span style="background-color: #d1fae5; color: #10b981; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;">Success</span>
                                </div>
                                
                                <div class="d-flex align-items-start">
                                    <div style="width: 32px; height: 32px; background-color: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px; flex-shrink: 0;">
                                        <i class="fa fa-user-plus" style="color: #3b82f6; font-size: 12px;"/>
                                    </div>
                                    <div style="flex: 1;">
                                        <p style="margin: 0; font-weight: 500; color: #1a1a2e;">New customer registered: Sarah Wilson</p>
                                        <p style="margin: 4px 0 0 0; font-size: 12px; color: #6c757d;">iPhone 15 • 4 hours ago</p>
                                    </div>
                                    <span style="background-color: #dbeafe; color: #3b82f6; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;">New</span>
                                </div>
                                
                                <div class="d-flex align-items-start">
                                    <div style="width: 32px; height: 32px; background-color: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px; flex-shrink: 0;">
                                        <i class="fa fa-exclamation" style="color: #ef4444; font-size: 12px;"/>
                                    </div>
                                    <div style="flex: 1;">
                                        <p style="margin: 0; font-weight: 500; color: #1a1a2e;">Overdue payment reminder sent to Mike Ross</p>
                                        <p style="margin: 4px 0 0 0; font-size: 12px; color: #6c757d;">€89.92 • 6 hours ago</p>
                                    </div>
                                    <span style="background-color: #fee2e2; color: #ef4444; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;">Alert</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>