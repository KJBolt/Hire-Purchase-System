<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template name="home" id="Home">
        <t t-call="website.layout">
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
                <style>
                    :root { --primary: #6366f1; --primary-dark: #4f46e5; --secondary: #0ea5e9; --success: #10b981; --warning: #f59e0b; --danger: #ef4444; }
                    * { font-family: 'Inter', sans-serif; }
                </style>
            </t>
            <section class="py-5"></section>
        </t>
    </template>

    <template name="customer_portal_template" id="customer_portal_template">
        <t t-call="website.layout">
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
                <link rel="stylesheet" href="/gobtechnologies/static/src/scss/customer_portal.scss" />
            </t>

            <div class="portal-page">
                <div class="portal-bg-shapes">
                    <div class="shape shape-1"></div>
                    <div class="shape shape-2"></div>
                    <div class="shape shape-3"></div>
                </div>
                <div class="portal-card">
                    <div class="portal-card-inner">
                        <div class="portal-logo">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <h1 class="portal-title">Customer Portal</h1>
                        <p class="portal-subtitle">Sign in to manage your hire purchase payments</p>

                        <div id="phone-form">
                            <div class="input-group-custom">
                                <i class="fas fa-phone-alt input-icon"></i>
                                <input type="text" id="phone_no" class="form-input" placeholder=" " autocomplete="tel" />
                                <label class="input-label" for="phone_no">Phone Number</label>
                            </div>
                            <button id="request-otp-btn" class="btn-primary-custom w-100">
                                <span class="btn-text"><i class="fas fa-paper-plane me-2"></i>Request OTP</span>
                                <span class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Sending...</span>
                            </button>
                            <div class="portal-footer-text">
                                <i class="fas fa-shield-alt me-1"></i>We'll send a 6-digit code to your phone
                            </div>
                        </div>

                        <div id="otp-form" class="d-none">
                            <p class="otp-instruction">
                                <i class="fas fa-mobile-alt me-2"></i>Enter the 6-digit code sent to
                                <strong id="otp-phone-display"></strong>
                            </p>
                            <div class="otp-container">
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                                <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                            </div>
                            <input type="hidden" id="otp_code" />
                            <div class="otp-timer" id="otp-timer">
                                <i class="far fa-clock me-1"></i><span id="otp-countdown">05:00</span>
                            </div>
                            <button id="verify-otp-btn" class="btn-primary-custom w-100">
                                <span class="btn-text"><i class="fas fa-check-circle me-2"></i>Verify &amp; Sign In</span>
                                <span class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Verifying...</span>
                            </button>
                            <button id="back-btn" class="btn-secondary-custom w-100 mt-2">
                                <i class="fas fa-arrow-left me-2"></i>Change Phone Number
                            </button>
                            <button id="resend-otp-btn" class="btn-link-custom w-100 mt-2 d-none">
                                <i class="fas fa-redo me-2"></i>Resend OTP
                            </button>
                        </div>

                        <div id="loading" class="d-none py-4">
                            <div class="spinner-custom"></div>
                        </div>

                        <div id="alert-message" class="alert-custom d-none"></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template name="customer_dashboard_template" id="customer_dashboard_template">
        <t t-call="website.layout">
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
                <link rel="stylesheet" href="/gobtechnologies/static/src/scss/customer_portal.scss" />
            </t>

            <div class="dash-wrap">
                <header class="dash-header">
                    <div class="dash-header-bg"></div>
                    <div class="container">
                        <div class="dash-header-row">
                            <div class="dash-welcome">
                                <div class="dash-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <h2>Welcome back</h2>
                                    <p><t t-esc="customer_name" /></p>
                                </div>
                            </div>
                            <a href="/customer/logout" class="dash-logout-btn">
                                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
                            </a>
                        </div>
                    </div>
                </header>

                <main class="container dash-main">
                    <!-- Info Bar -->
                    <div class="info-bar">
                        <div class="info-item">
                            <div class="info-icon" style="background:#eef2ff;">
                                <i class="fas fa-hashtag" style="color:#6366f1;"></i>
                            </div>
                            <div>
                                <span class="info-label">Reference</span>
                                <span class="info-value"><t t-esc="repayment.unique_id" /></span>
                            </div>
                        </div>
                        <div class="info-divider"></div>
                        <div class="info-item">
                            <div class="info-icon" style="background:#ecfdf5;">
                                <i class="fas fa-phone-alt" style="color:#10b981;"></i>
                            </div>
                            <div>
                                <span class="info-label">Phone</span>
                                <span class="info-value"><t t-esc="phone_no" /></span>
                            </div>
                        </div>
                        <div class="info-divider"></div>
                        <div class="info-item">
                            <div class="info-icon" style="background:#fef2f2;">
                                <i class="fas fa-tag" style="color:#ef4444;"></i>
                            </div>
                            <div>
                                <span class="info-label">Status</span>
                                <span class="info-value"><t t-esc="repayment.state" /></span>
                            </div>
                        </div>
                    </div>

                    <!-- Stats -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="stat-card stat-card-primary">
                                <div class="stat-card-icon"><i class="fas fa-shopping-cart"></i></div>
                                <div class="stat-card-body">
                                    <div class="stat-card-label">Total Price</div>
                                    <div class="stat-card-value">GHS <t t-esc="selling_price" /></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card stat-card-success">
                                <div class="stat-card-icon"><i class="fas fa-check-circle"></i></div>
                                <div class="stat-card-body">
                                    <div class="stat-card-label">Total Paid</div>
                                    <div class="stat-card-value">GHS <t t-esc="total_paid" /></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card stat-card-warning">
                                <div class="stat-card-icon"><i class="fas fa-hourglass-half"></i></div>
                                <div class="stat-card-body">
                                    <div class="stat-card-label">Outstanding</div>
                                    <div class="stat-card-value">GHS <t t-esc="outstanding_balance" /></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Form -->
                    <div class="dash-card mb-4">
                        <div class="dash-card-header">
                            <i class="fas fa-credit-card" style="color:#6366f1;"></i>
                            <span>Make a Payment</span>
                        </div>
                        <div class="dash-card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-8">
                                    <label class="payment-label">
                                        <i class="fas fa-money-bill-wave me-1"></i>Payment Amount (GHS)
                                    </label>
                                    <div class="payment-input-wrap">
                                        <span class="payment-currency">GHS</span>
                                        <input type="number" id="payment_amount" class="payment-input" placeholder="0.00" step="0.01" min="0.01" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <button id="initiate-payment-btn" class="btn-pay w-100">
                                        <span class="btn-text"><i class="fas fa-bolt me-2"></i>Pay Now</span>
                                        <span class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Processing...</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment History -->
                    <div class="dash-card mb-4">
                        <div class="dash-card-header">
                            <i class="fas fa-clock-rotate" style="color:#10b981;"></i>
                            <span>Payment History</span>
                        </div>
                        <div class="dash-card-body p-0">
                            <div class="table-responsive">
                                <table class="dash-table">
                                    <thead>
                                        <tr>
                                            <th><i class="far fa-calendar-alt me-1"></i>Date</th>
                                            <th>Amount</th>
                                            <th>Mode</th>
                                            <th>Status</th>
                                            <th class="text-center">Receipt</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="payment_lines" t-as="payment">
                                            <tr>
                                                <td data-label="Date">
                                                    <span class="cell-date"><t t-esc="payment['payment_date']" /></span>
                                                </td>
                                                <td data-label="Amount">
                                                    <span class="cell-amount">GHS <t t-esc="payment['payment_amount']" /></span>
                                                </td>
                                                <td data-label="Mode">
                                                    <span class="cell-mode">
                                                        <t t-if="'Mobile Money' in payment['payment_mode'] or 'momo' in payment['payment_mode'].lower()">
                                                            <i class="fas fa-mobile-alt me-1" style="color:#6366f1;"></i>
                                                        </t>
                                                        <t t-elif="'Cash' in payment['payment_mode']">
                                                            <i class="fas fa-money-bill me-1" style="color:#10b981;"></i>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fas fa-exchange-alt me-1"></i>
                                                        </t>
                                                        <t t-esc="payment['payment_mode']" />
                                                    </span>
                                                </td>
                                                <td data-label="Status">
                                                    <t t-if="'Fully Paid' == payment['payment_status'] or 'Overpaid' == payment['payment_status']">
                                                        <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i><t t-esc="payment['payment_status']" /></span>
                                                    </t>
                                                    <t t-elif="'Underpaid' == payment['payment_status']">
                                                        <span class="badge badge-warning"><i class="fas fa-exclamation-triangle me-1"></i><t t-esc="payment['payment_status']" /></span>
                                                    </t>
                                                    <t t-elif="'pending' == payment['payment_status'].lower()">
                                                        <span class="badge badge-pending"><i class="fas fa-clock me-1"></i>Pending</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge badge-info"><t t-esc="payment['payment_status']" /></span>
                                                    </t>
                                                </td>
                                                <td class="text-center" data-label="Receipt">
                                                    <a t-attf-href="/customer/receipt/{{ payment['id'] }}" class="btn-receipt" target="_blank">
                                                        <i class="fas fa-download me-1"></i>PDF
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="not payment_lines">
                                            <tr>
                                                <td colspan="5" class="empty-state">
                                                    <i class="fas fa-receipt"></i>
                                                    <p>No payment history yet</p>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </main>

                <footer class="dash-footer">
                    <div class="container">
                        <p>Sarfosco Hire Purchase System &copy; <t t-esc="str(fields.Date.today().year)" />. All rights reserved.</p>
                    </div>
                </footer>
            </div>
        </t>
    </template>
</odoo>
