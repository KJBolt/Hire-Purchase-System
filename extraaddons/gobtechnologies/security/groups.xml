<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_repayment" model="ir.module.category">
            <field name="name">Sarfosco Phones</field>
            <field name="sequence">5</field>
        </record>

        <!-- Bottom Level Roles -->
        <record id="group_repayment_agent" model="res.groups">
            <field name="name">Sales Agent</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="comment">Sales deliveries, own sales reports, commission tracking</field>
        </record>

        <record id="group_repayment_sales" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="implied_ids" eval="[(4, ref('group_repayment_agent'))]"/>
            <field name="comment">Agent management, sales reports, agent-customer relationships</field>
        </record>

        <!-- Mid Level Roles -->
        <record id="group_sales_administrator" model="res.groups">
            <field name="name">Sales Administrator</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="implied_ids" eval="[(4, ref('group_repayment_sales'))]"/>
            <field name="comment">User creation, stock management, audit logs</field>
        </record>

        <record id="group_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_administrator'))]"/>
            <field name="comment">Supervises Sales Manager, has all access rights</field>
        </record>

        <!-- Top Level Roles -->
        <record id="group_general_manager" model="res.groups">
            <field name="name">General Manager</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="implied_ids" eval="[(4, ref('group_supervisor'))]"/>
            <field name="comment">Full access to all system features and reports</field>
        </record>

        

        <!-- Support Roles -->
        <record id="group_customer_care" model="res.groups">
            <field name="name">Customer Care Representative</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="comment">Invoice reports, troubleshooting</field>
        </record>

        <!-- Audit Roles -->
        <record id="group_internal_auditor" model="res.groups">
            <field name="name">Internal Auditor</field>
            <field name="category_id" ref="module_category_repayment"/>
            <field name="comment">Read-only access to inventory and sales reports</field>
        </record>
    </data>
</odoo>