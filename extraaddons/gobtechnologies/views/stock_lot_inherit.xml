<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_lot_tree_inherit" model="ir.ui.view">
            <field name="name">stock.lot.tree.inherit</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="delivery_status" readonly="1" widget="badge" decoration-success="delivery_status == 'delivered'" decoration-warning="delivery_status == 'not_delivered'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>